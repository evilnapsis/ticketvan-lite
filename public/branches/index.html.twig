{% extends "layouts/main.html.twig" %}

{% block title %}Terminales{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Terminales</h3>
  {% if curr_user.role == 'admin' %}
  <a href="{{ base_url }}/branches/new" class="btn btn-danger">
    <i class="bi bi-plus-circle me-1"></i> Nueva Terminal
  </a>
  {% endif %}
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Ciudad</th>
            <th>Teléfono</th>
            <th>Estado</th>
            {% if curr_user.role == 'admin' %}<th class="text-end">Acciones</th>{% endif %}
          </tr>
        </thead>
        <tbody>
          {% for b in branches %}
          <tr>
            <td class="fw-bold">{{ b.code ?: '-' }}</td>
            <td>{{ b.name }}</td>
            <td>{{ b.city }}</td>
            <td>{{ b.phone ?: '-' }}</td>
            <td>
              <span class="badge bg-{{ b.is_active ? 'success' : 'secondary' }}">
                {{ b.is_active ? 'Activa' : 'Inactiva' }}
              </span>
            </td>
            {% if curr_user.role == 'admin' %}
            <td class="text-end text-nowrap">
              <a href="{{ base_url }}/branches/{{ b.id }}/edit" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
              <form method="post" action="{{ base_url }}/branches/{{ b.id }}/delete" class="d-inline confirm-post" data-confirm="¿Eliminar terminal {{ b.name }}?">
                {{ csrf_field() }}
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
            {% endif %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
