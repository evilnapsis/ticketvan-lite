{% extends "layouts/main.html.twig" %}

{% block title %}Editar Terminal{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Editar Terminal</h3>
  <a href="{{ base_url }}/branches" class="btn btn-outline-secondary">Volver</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <form method="post" action="{{ base_url }}/branches/{{ branch.id }}/update" class="row g-3">
      {{ csrf_field() }}
      <div class="col-md-3">
        <label class="form-label fw-semibold">Código</label>
        <input type="text" name="code" value="{{ branch.code }}" class="form-control">
      </div>
      <div class="col-md-5">
        <label class="form-label fw-semibold">Nombre *</label>
        <input type="text" name="name" value="{{ branch.name }}" class="form-control" required>
      </div>
      <div class="col-md-4">
        <label class="form-label fw-semibold">Ciudad *</label>
        <input type="text" name="city" value="{{ branch.city }}" class="form-control" required>
      </div>
      <div class="col-md-8">
        <label class="form-label fw-semibold">Dirección</label>
        <input type="text" name="address" value="{{ branch.address }}" class="form-control">
      </div>
      <div class="col-md-4">
        <label class="form-label fw-semibold">Teléfono</label>
        <input type="text" name="phone" value="{{ branch.phone }}" class="form-control">
      </div>
      <div class="col-12">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="is_active" id="isActive" {{ branch.is_active ? 'checked' : '' }}>
          <label class="form-check-label" for="isActive">Activa</label>
        </div>
      </div>
      <div class="col-12 text-end">
        <button type="submit" class="btn btn-danger px-4"><i class="bi bi-save me-1"></i> Actualizar</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
