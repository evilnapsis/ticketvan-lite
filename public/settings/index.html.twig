{% extends "layouts/main.html.twig" %}

{% block title %}Configuración{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Configuración</h3>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <form method="post" action="{{ base_url }}/settings/update" class="row g-3">
      {{ csrf_field() }}
      <div class="col-md-6">
        <label class="form-label fw-semibold">Nombre de la Empresa</label>
        <input type="text" name="company_name" value="{{ settings.company_name|default('') }}" class="form-control" required>
      </div>
      <div class="col-md-3">
        <label class="form-label fw-semibold">RFC</label>
        <input type="text" name="company_rfc" value="{{ settings.company_rfc|default('') }}" class="form-control">
      </div>
      <div class="col-md-3">
        <label class="form-label fw-semibold">Teléfono</label>
        <input type="text" name="company_phone" value="{{ settings.company_phone|default('') }}" class="form-control">
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Dirección</label>
        <input type="text" name="company_address" value="{{ settings.company_address|default('') }}" class="form-control">
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Correo de Contacto</label>
        <input type="email" name="company_email" value="{{ settings.company_email|default('') }}" class="form-control">
      </div>
      <div class="col-12">
        <label class="form-label fw-semibold">Leyenda del Boleto</label>
        <textarea name="ticket_note" rows="3" class="form-control">{{ settings.ticket_note|default('') }}</textarea>
      </div>
      <div class="col-12 text-end">
        <button type="submit" class="btn btn-danger px-4"><i class="bi bi-save me-1"></i> Guardar Configuración</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
