{% extends "layouts/main.html.twig" %}

{% block title %}Boletos Emitidos{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Boletos Emitidos</h3>
  <a href="{{ base_url }}/pos" class="btn btn-danger">
    <i class="bi bi-plus-circle me-1"></i> Vender Boleto
  </a>
</div>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body">
    <form method="get" action="{{ base_url }}/tickets" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small fw-semibold">Desde</label>
        <input type="date" name="start_date" value="{{ start_date }}" class="form-control">
      </div>
      <div class="col-md-3">
        <label class="form-label small fw-semibold">Hasta</label>
        <input type="date" name="end_date" value="{{ end_date }}" class="form-control">
      </div>
      <div class="col-md-3">
        <label class="form-label small fw-semibold">Estado</label>
        <select name="status" class="form-select">
          <option value="">Todos</option>
          <option value="sold" {{ status == 'sold' ? 'selected' : '' }}>Vendido</option>
          <option value="cancelled" {{ status == 'cancelled' ? 'selected' : '' }}>Cancelado</option>
        </select>
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">
          <i class="bi bi-funnel me-1"></i> Filtrar
        </button>
      </div>
    </form>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Fecha Venta</th>
            <th>Corrida</th>
            <th>Asiento</th>
            <th>Pasajero</th>
            <th>Método</th>
            <th>Precio</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for tk in tickets %}
          <tr>
            <td class="fw-bold">#{{ tk.id }}</td>
            <td class="small">{{ tk.created_at|date('d/m/Y H:i') }}</td>
            <td>
              <div class="fw-semibold small">{{ tk.origin_name }} → {{ tk.destination_name }}</div>
              <div class="text-muted" style="font-size: 11px;">Salida: {{ tk.departure_at|date('d/m/Y H:i') }}</div>
            </td>
            <td><span class="badge bg-dark">#{{ tk.seat_number }}</span></td>
            <td>
              <div>{{ tk.passenger_name }}</div>
              {% if tk.passenger_phone %}<div class="text-muted small">{{ tk.passenger_phone }}</div>{% endif %}
            </td>
            <td class="small">
              {% if tk.payment_method == 'cash' %}Efectivo{% elseif tk.payment_method == 'card' %}Tarjeta{% else %}Transferencia{% endif %}
            </td>
            <td class="fw-semibold">${{ tk.price|number_format(2) }}</td>
            <td>
              {% if tk.status == 'sold' %}
              <span class="badge bg-success">Vendido</span>
              {% else %}
              <span class="badge bg-secondary">Cancelado</span>
              {% endif %}
            </td>
            <td class="text-end text-nowrap">
              <a href="{{ base_url }}/tickets/{{ tk.id }}/print" target="_blank" class="btn btn-sm btn-outline-dark" title="Imprimir">
                <i class="bi bi-printer"></i>
              </a>
              <a href="{{ base_url }}/tickets/{{ tk.id }}" class="btn btn-sm btn-outline-primary" title="Ver detalle">
                <i class="bi bi-eye"></i>
              </a>
              {% if tk.status == 'sold' %}
              <form method="post" action="{{ base_url }}/tickets/{{ tk.id }}/cancel" class="d-inline confirm-post" data-confirm="¿Cancelar boleto #{{ tk.id }} y liberar el asiento?">
                {{ csrf_field() }}
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar boleto">
                  <i class="bi bi-x-circle"></i>
                </button>
              </form>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
