{% extends "layouts/main.html.twig" %}

{% block title %}Reporte de Ventas{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Reporte de Ventas</h3>
</div>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body">
    <form method="get" action="{{ base_url }}/reports" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Desde</label>
        <input type="date" name="start_date" value="{{ start_date }}" class="form-control">
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Hasta</label>
        <input type="date" name="end_date" value="{{ end_date }}" class="form-control">
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Consultar</button>
      </div>
    </form>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Total Boletos Vendidos</div>
        <div class="fs-3 fw-bold">{{ grand_tickets }}</div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Ingresos Totales</div>
        <div class="fs-3 fw-bold text-danger">${{ grand_total|number_format(2) }}</div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small mb-1">Por Método de Pago</div>
        {% for s in summary %}
        <div class="d-flex justify-content-between small">
          <span>{{ s.payment_method == 'cash' ? 'Efectivo' : (s.payment_method == 'card' ? 'Tarjeta' : 'Transferencia') }} ({{ s.total_tickets }})</span>
          <span class="fw-bold">${{ s.total_amount|number_format(2) }}</span>
        </div>
        {% else %}
        <span class="text-muted small">Sin ventas en el periodo.</span>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Fecha</th>
            <th>Trayecto</th>
            <th>Pasajero</th>
            <th>Asiento</th>
            <th>Método</th>
            <th>Taquillero</th>
            <th>Precio</th>
          </tr>
        </thead>
        <tbody>
          {% for tk in tickets %}
          <tr>
            <td>#{{ tk.id }}</td>
            <td class="small">{{ tk.created_at|date('d/m/Y H:i') }}</td>
            <td class="small">{{ tk.origin_name }} → {{ tk.destination_name }}</td>
            <td>{{ tk.passenger_name }}</td>
            <td><span class="badge bg-dark">#{{ tk.seat_number }}</span></td>
            <td class="small">{{ tk.payment_method == 'cash' ? 'Efectivo' : (tk.payment_method == 'card' ? 'Tarjeta' : 'Transferencia') }}</td>
            <td class="small">{{ tk.seller_name }}</td>
            <td class="fw-semibold">${{ tk.price|number_format(2) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
