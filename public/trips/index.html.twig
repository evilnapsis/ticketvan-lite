{% extends "layouts/main.html.twig" %}

{% block title %}Corridas{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Corridas</h3>
  {% if curr_user.role == 'admin' %}
  <a href="{{ base_url }}/trips/new" class="btn btn-danger">
    <i class="bi bi-plus-circle me-1"></i> Nueva Corrida
  </a>
  {% endif %}
</div>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body">
    <form method="get" action="{{ base_url }}/trips" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Fecha</label>
        <input type="date" name="date" value="{{ date }}" class="form-control">
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Estado</label>
        <select name="status" class="form-select">
          <option value="">Todos</option>
          <option value="scheduled" {{ status == 'scheduled' ? 'selected' : '' }}>Programada</option>
          <option value="boarding" {{ status == 'boarding' ? 'selected' : '' }}>Abordando</option>
          <option value="departed" {{ status == 'departed' ? 'selected' : '' }}>En camino</option>
          <option value="completed" {{ status == 'completed' ? 'selected' : '' }}>Completada</option>
          <option value="cancelled" {{ status == 'cancelled' ? 'selected' : '' }}>Cancelada</option>
        </select>
      </div>
      <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filtrar</button>
        <a href="{{ base_url }}/trips" class="btn btn-outline-secondary">Limpiar</a>
      </div>
    </form>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Salida</th>
            <th>Origen → Destino</th>
            <th>Vehículo</th>
            <th>Precio</th>
            <th>Ocupación</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for t in trips %}
          <tr>
            <td>#{{ t.id }}</td>
            <td class="fw-semibold">{{ t.departure_at|date('d/m/Y H:i') }}</td>
            <td>{{ t.origin_name }} → {{ t.destination_name }}</td>
            <td>
              <div class="small fw-semibold">{{ t.vehicle_plate }}</div>
              <div class="text-muted" style="font-size:11px;">{{ t.vehicle_name }}</div>
            </td>
            <td class="fw-semibold">${{ t.price|number_format(2) }}</td>
            <td>
              <span class="badge bg-{{ t.available_seats > 0 ? 'success' : 'secondary' }}">
                {{ t.sold_seats }} / {{ t.total_seat }}
              </span>
            </td>
            <td>
              {% if t.status == 'scheduled' %}<span class="badge bg-primary">Programada</span>
              {% elseif t.status == 'boarding' %}<span class="badge bg-warning text-dark">Abordando</span>
              {% elseif t.status == 'departed' %}<span class="badge bg-info text-dark">En camino</span>
              {% elseif t.status == 'completed' %}<span class="badge bg-success">Completada</span>
              {% else %}<span class="badge bg-danger">Cancelada</span>{% endif %}
            </td>
            <td class="text-end text-nowrap">
              {% if t.status in ['scheduled', 'boarding'] %}
              <a href="{{ base_url }}/pos?trip_id={{ t.id }}" class="btn btn-sm btn-danger" title="Vender boletos">
                <i class="bi bi-ticket-perforated"></i>
              </a>
              {% endif %}
              <a href="{{ base_url }}/trips/{{ t.id }}" class="btn btn-sm btn-outline-primary" title="Detalle">
                <i class="bi bi-eye"></i>
              </a>
              <a href="{{ base_url }}/trips/{{ t.id }}/manifest" target="_blank" class="btn btn-sm btn-outline-dark" title="Lista de pasajeros">
                <i class="bi bi-list-check"></i>
              </a>
              {% if curr_user.role == 'admin' %}
              <a href="{{ base_url }}/trips/{{ t.id }}/edit" class="btn btn-sm btn-outline-warning" title="Editar">
                <i class="bi bi-pencil"></i>
              </a>
              <form method="post" action="{{ base_url }}/trips/{{ t.id }}/delete" class="d-inline confirm-post" data-confirm="¿Eliminar la corrida #{{ t.id }}?">
                {{ csrf_field() }}
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
              </form>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
