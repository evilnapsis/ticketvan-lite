{% extends "layouts/main.html.twig" %}

{% block title %}Editar Corrida #{{ trip.id }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Editar Corrida #{{ trip.id }}</h3>
  <a href="{{ base_url }}/trips" class="btn btn-outline-secondary">Volver</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <form method="post" action="{{ base_url }}/trips/{{ trip.id }}/update" class="row g-3">
      {{ csrf_field() }}
      <div class="col-md-6">
        <label class="form-label fw-semibold">Terminal Origen *</label>
        <select name="origin_branch_id" class="form-select select2" required>
          {% for b in branches %}
          <option value="{{ b.id }}" {{ trip.origin_branch_id == b.id ? 'selected' : '' }}>{{ b.name }} ({{ b.city }})</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Terminal Destino *</label>
        <select name="destination_branch_id" class="form-select select2" required>
          {% for b in branches %}
          <option value="{{ b.id }}" {{ trip.destination_branch_id == b.id ? 'selected' : '' }}>{{ b.name }} ({{ b.city }})</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label fw-semibold">Vehículo Asignado *</label>
        <select name="vehicle_id" class="form-select select2" required>
          {% for v in vehicles %}
          <option value="{{ v.id }}" {{ trip.vehicle_id == v.id ? 'selected' : '' }}>{{ v.plate }} - {{ v.name }} ({{ v.total_seat }} asientos)</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label fw-semibold">Fecha y Hora de Salida *</label>
        <input type="datetime-local" name="departure_at" value="{{ trip.departure_at|date('Y-m-d\\TH:i') }}" class="form-control" required>
      </div>
      <div class="col-md-4">
        <label class="form-label fw-semibold">Precio del Boleto ($) *</label>
        <input type="number" name="price" step="0.01" min="0" value="{{ trip.price }}" class="form-control" required>
      </div>
      <div class="col-md-4">
        <label class="form-label fw-semibold">Estado</label>
        <select name="status" class="form-select">
          <option value="scheduled" {{ trip.status == 'scheduled' ? 'selected' : '' }}>Programada</option>
          <option value="boarding" {{ trip.status == 'boarding' ? 'selected' : '' }}>Abordando</option>
          <option value="departed" {{ trip.status == 'departed' ? 'selected' : '' }}>En camino</option>
          <option value="completed" {{ trip.status == 'completed' ? 'selected' : '' }}>Completada</option>
          <option value="cancelled" {{ trip.status == 'cancelled' ? 'selected' : '' }}>Cancelada</option>
        </select>
      </div>
      <div class="col-md-8">
        <label class="form-label fw-semibold">Notas</label>
        <input type="text" name="notes" value="{{ trip.notes }}" class="form-control">
      </div>
      <div class="col-12 text-end">
        <button type="submit" class="btn btn-danger px-4">
          <i class="bi bi-save me-1"></i> Actualizar Corrida
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
