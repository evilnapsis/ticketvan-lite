{% extends "layouts/main.html.twig" %}

{% block title %}Dashboard{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0 fw-bold">Dashboard</h3>
  <a href="{{ base_url }}/pos" class="btn btn-danger">
    <i class="bi bi-ticket-perforated me-1"></i> Vender Boleto
  </a>
</div>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body d-flex align-items-center">
        <div class="bg-danger bg-opacity-10 text-danger rounded p-3 me-3">
          <i class="bi bi-cash-stack fs-3"></i>
        </div>
        <div>
          <div class="text-muted small">Ingresos Hoy</div>
          <div class="fs-4 fw-bold">${{ today_amount|number_format(2, '.', ',') }}</div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body d-flex align-items-center">
        <div class="bg-primary bg-opacity-10 text-primary rounded p-3 me-3">
          <i class="bi bi-ticket-perforated fs-3"></i>
        </div>
        <div>
          <div class="text-muted small">Boletos Hoy</div>
          <div class="fs-4 fw-bold">{{ today_tickets }}</div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body d-flex align-items-center">
        <div class="bg-success bg-opacity-10 text-success rounded p-3 me-3">
          <i class="bi bi-bus-front fs-3"></i>
        </div>
        <div>
          <div class="text-muted small">Corridas Hoy</div>
          <div class="fs-4 fw-bold">{{ today_trips_count }}</div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body d-flex align-items-center">
        <div class="bg-warning bg-opacity-10 text-warning rounded p-3 me-3">
          <i class="bi bi-clock-history fs-3"></i>
        </div>
        <div>
          <div class="text-muted small">Salidas Abiertas</div>
          <div class="fs-4 fw-bold">{{ upcoming_trips_count }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white fw-semibold">
        <i class="bi bi-graph-up me-1 text-danger"></i> Ventas Últimos 30 Días
      </div>
      <div class="card-body">
        <canvas id="salesChart" height="140"></canvas>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar-event me-1 text-danger"></i> Corridas de Hoy</span>
        <a href="{{ base_url }}/trips" class="btn btn-sm btn-outline-secondary">Ver todas</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 no-datatable align-middle">
            <thead class="table-light">
              <tr>
                <th>Hora</th>
                <th>Trayecto</th>
                <th>Asientos</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {% for t in today_trips %}
              <tr>
                <td class="fw-semibold">{{ t.departure_at|date('H:i') }}</td>
                <td>
                  <div class="small fw-semibold">{{ t.origin_name }} → {{ t.destination_name }}</div>
                  <div class="text-muted" style="font-size: 11px;">{{ t.vehicle_plate }} · ${{ t.price|number_format(2) }}</div>
                </td>
                <td>
                  <span class="badge bg-{{ t.available_seats > 0 ? 'success' : 'secondary' }}">
                    {{ t.sold_seats }}/{{ t.total_seat }}
                  </span>
                </td>
                <td class="text-end">
                  {% if t.status in ['scheduled', 'boarding'] %}
                  <a href="{{ base_url }}/pos?trip_id={{ t.id }}" class="btn btn-sm btn-danger" title="Vender">
                    <i class="bi bi-ticket-perforated"></i>
                  </a>
                  {% endif %}
                </td>
              </tr>
              {% else %}
              <tr>
                <td colspan="4" class="text-center text-muted py-4">No hay corridas programadas para hoy.</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
(function() {
  const ctx = document.getElementById('salesChart');
  if (!ctx) return;
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: {{ chart_labels|raw }},
      datasets: [{
        label: 'Ingresos ($)',
        data: {{ chart_amounts|raw }},
        borderColor: '#c0392b',
        backgroundColor: 'rgba(192, 57, 43, 0.12)',
        fill: true,
        tension: 0.3
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        y: { beginAtZero: true }
      }
    }
  });
})();
</script>
{% endblock %}
