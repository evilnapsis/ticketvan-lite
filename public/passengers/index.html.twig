{% extends "layouts/main.html.twig" %}

{% block title %}Pasajeros{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Pasajeros</h3>
  <a href="{{ base_url }}/passengers/new" class="btn btn-danger">
    <i class="bi bi-plus-circle me-1"></i> Nuevo Pasajero
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Nombre</th>
            <th>Documento / INE</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for p in passengers %}
          <tr>
            <td class="fw-semibold">{{ p.first_name }} {{ p.last_name }}</td>
            <td>{{ p.document_number ?: '-' }}</td>
            <td>{{ p.phone ?: '-' }}</td>
            <td>{{ p.email ?: '-' }}</td>
            <td>
              <span class="badge bg-{{ p.is_active ? 'success' : 'secondary' }}">{{ p.is_active ? 'Activo' : 'Inactivo' }}</span>
            </td>
            <td class="text-end text-nowrap">
              <a href="{{ base_url }}/passengers/{{ p.id }}/edit" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
              {% if curr_user.role == 'admin' %}
              <form method="post" action="{{ base_url }}/passengers/{{ p.id }}/delete" class="d-inline confirm-post" data-confirm="¿Eliminar pasajero {{ p.first_name }} {{ p.last_name }}?">
                {{ csrf_field() }}
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
