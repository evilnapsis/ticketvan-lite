{% extends "layouts/main.html.twig" %}

{% block title %}Vehículos{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Vehículos</h3>
  {% if curr_user.role == 'admin' %}
  <a href="{{ base_url }}/vehicles/new" class="btn btn-danger">
    <i class="bi bi-plus-circle me-1"></i> Nuevo Vehículo
  </a>
  {% endif %}
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Placa</th>
            <th>Nombre / Unidad</th>
            <th>Tipo</th>
            <th>Asientos</th>
            <th>Estado</th>
            {% if curr_user.role == 'admin' %}<th class="text-end">Acciones</th>{% endif %}
          </tr>
        </thead>
        <tbody>
          {% for v in vehicles %}
          <tr>
            <td class="fw-bold">{{ v.plate }}</td>
            <td>{{ v.name ?: '-' }}</td>
            <td>{{ v.type == 'van' ? 'Van' : 'Autobús' }}</td>
            <td><span class="badge bg-dark">{{ v.total_seat }}</span></td>
            <td>
              <span class="badge bg-{{ v.is_active ? 'success' : 'secondary' }}">
                {{ v.is_active ? 'Activo' : 'Inactivo' }}
              </span>
            </td>
            {% if curr_user.role == 'admin' %}
            <td class="text-end text-nowrap">
              <a href="{{ base_url }}/vehicles/{{ v.id }}/edit" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
              <form method="post" action="{{ base_url }}/vehicles/{{ v.id }}/delete" class="d-inline confirm-post" data-confirm="¿Eliminar vehículo {{ v.plate }}?">
                {{ csrf_field() }}
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
            {% endif %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
